#version 430 core

layout(location = 0) in vec3 position;

//out vec2 textureCoords;

uniform MatVP{
	mat4 View;
	mat4 Projection;
};

uniform mat4 Model;

void main(void) {
    gl_Position = Projection * View * Model * vec4(position.x, 0.0, position.y, 1.0); // ­pºâ³Ì²×¦ì¸m
    //textureCoords = vec2(position.x / 2.0 + 0.5, position.y / 2.0 + 0.5);
}
#version 430 core
layout (location = 0) in vec3 aPos;

out vec3 texCoords;

uniform MatVP{
    mat4 View;
    mat4 Projection;
};

void main()
{
    mat4 viewWithoutTranslation = mat4(mat3(View));

    vec4 pos = Projection * viewWithoutTranslation * vec4(aPos, 1.0f);

    gl_Position = pos.xyww;

    texCoords = aPos;
}
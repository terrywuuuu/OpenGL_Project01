#version 430

layout (location = 0) in vec3 vPosition;
layout(location = 1) in vec2 vertexUV;
layout(location = 2) in vec3 vertexNormal;

uniform mat4 Model;
uniform bool isInstanced;
uniform int MultipleMode;
uniform bool lightCube;

uniform MatVP{
	mat4 View;
	mat4 Projection;
};

uniform mat4 shadowMatrices;  // VP 矩陣

out vec4 FragPosLightSpace;  // 傳給 Fragment shader，用來寫入深度

void main()
{
    vec4 worldPos = Model * vec4(vPosition, 1.0);
    FragPosLightSpace = worldPos;
    gl_Position = shadowMatrices * worldPos;
}